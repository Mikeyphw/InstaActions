<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="ps.reso.instaeclipse" />
    </queries>
    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:icon="@drawable/ic_instaactions"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Bounded automatic root monitor while user navigates to Instagram. -->
        <service android:name=".R1CD19RootWatchService" android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="short user-visible read-only app diagnostics" />
        </service>
        <!-- D20: single Boolean policy readable by the real Instagram UID only; no writes. -->
        <provider android:name=".R1CD20FabPolicyProvider"
                  android:authorities="com.mikeyphw.instaactions.fabpolicy"
                  android:exported="true" android:grantUriPermissions="false" />
        <!-- Explicit cross-UID diagnostics only. Runtime UID check is mandatory. -->
        <receiver android:name=".R1CD16LogReceiver" android:exported="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/module_description" />
        <meta-data android:name="xposedminversion" android:value="102" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
